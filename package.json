{
  "name": "silver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.cli.json && vite build",
    "test": "node --test --experimental-strip-types src/agent-core/seats.test.ts src/agent-core/iterate.test.ts src/i18n/errors.test.ts cli/infrastructure.test.ts cli/gitDiff.test.ts cli/fileEdit.test.ts cli/check.test.ts cli/codingPreflight.test.ts cli/codingProject.test.ts cli/codingSymbols.test.ts cli/codingToolLoop.test.ts cli/codingContext.test.ts cli/codingTasks.test.ts cli/codingPlugins.test.ts",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "build:cli": "tsc -p tsconfig.cli.json && node cli/bundle.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b && tsc -p tsconfig.cli.json",
    "test:desktop-runtime": "npm run build:cli && node --test cli/runtime.test.mjs"
  },
  "dependencies": {
    "@fontpkg/lxgw-neo-xi-hei": "^1.110.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "highlight.js": "$highlight.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
