{
  "name": "silver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.cli.json && vite build",
    "test": "node --test --experimental-strip-types src/model/seats.test.ts src/model/iterate.test.ts cli/infrastructure.test.ts",
