    "test:desktop-runtime": "npm run build:cli && node --test cli/runtime.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
